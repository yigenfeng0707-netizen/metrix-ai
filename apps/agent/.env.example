# ===== 运行模式 =====
# sim  = 内置模拟行情 + 模拟成交（无需任何链上配置）
# live = 真实 Kuru 下单（W1 验证完成后再启用！）
AGENT_MODE=sim
PORT=8787

# ===== 模拟模式参数 =====
SIM_PRICE_MIN=2950
SIM_PRICE_MAX=3150

# ===== Monad / Kuru（live 模式必填）=====
# Monad 主网 Chain ID 143；测试网先用公共 RPC 验证
KURU_RPC_URL=
KURU_PRIVATE_KEY=
# Kuru 市场合约地址（W1: 从 Kuru 官方市场列表选择 USDC 深度最好的交易对）
KURU_MARKET_ADDRESS=
# 保证金账户合约地址（Kuru 下单前置：先充值并 approve）
KURU_MARGIN_ACCOUNT_ADDRESS=

# ===== Perpl 永续模块（P1，可选；默认关闭）=====
# 启用前置：① ≥100 aUSD 抵押 + Perpl profile
#           ② node scripts/perpl-enroll-testnet.mjs（写入本文件，勿提交）
#           ③ 链上 createAccount → 填 PERPL_ACCOUNT_ID
#           ④ node scripts/perpl-place-ioc.mjs 或 PERPL_ENABLED=true
# 详见 docs/agora-perpl-live-path.md 与 docs.perpl.xyz/.../authentication
PERPL_ENABLED=false
# 测试网示例（主网改 app.perpl.xyz / chain 143）
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_CHAIN_ID=10143
PERPL_API_KEY=
PERPL_PRIVATE_KEY=
# 官方文档别名（与 PERPL_PRIVATE_KEY 二选一）
# PERPL_API_KEY_SECRET=
PERPL_ACCOUNT_ID=0
PERPL_LEVERAGE=200
PERP_ORDER_USD=100
# 测试网常见：BTC=16 ETH=32 SOL=48 MON=64（以 /v1/pub/context 为准）
PERP_MARKET_ID=64
PERP_PRICE_DECIMALS=5
PERP_SIZE_DECIMALS=0

# 无 PostgreSQL 时写入本地 JSON（默认 /tmp/metrix-data 或 ./data）
# METRIX_DATA_DIR=

# ===== ML 信号服务（PyTorch GPU，可选；Docker compose 中默认开启）=====
# 启动：cd ml && python train.py（本地）或 docker compose up ml（GPU 自动检测）
ML_ENABLED=false
ML_URL=http://localhost:8900
ML_MIN_HISTORY=130
# 入场阈值：p_up >= 0.6 买 / <= 0.4 卖
ML_THRESHOLD=0.6

# ===== LLM：魔搭 API-Inference（Token 只放本机 .env 或创空间 Secrets，不要提交）=====
# Token 页：https://modelscope.cn/my/myaccesstoken
LLM_API_BASE=https://api-inference.modelscope.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# LLM_API_KEY 为空时也会读 MODELSCOPE_API_KEY
